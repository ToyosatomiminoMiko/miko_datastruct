{
  "name": "miko_datastruct",
  "version": "0.0.0",
  "private": true,
  "description": "Data structures: red-black tree",
  "type": "module",
  "dependencies": {
    "@preact/signals-core": "^1.14.4",
    "miko_ui": "^0.1.16"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node -e 'const fs = require(\"node:fs\"); fs.rmSync(\"dist\", { recursive: true, force: true });'",
    "build:app": "npm run typecheck && vite build",
    "build:all": "npm run clean && npm test && npm run build:app",
    "build": "npm run build:all",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters"
  }
}
